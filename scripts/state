#!/usr/bin/env python3
"""Derive the project's state from the files, and nothing else.

Usage:
  scripts/state            print the SCOPE §2 pairs table, the §4 stage table and the
                           v1.0 checklist
  scripts/state --write    rewrite both tables in SCOPE.md, and the status line and
                           citation in README.md, between their markers
  scripts/state --check    exit 1 if any of those differ from what the files say, or
                           if CITATION.cff's version is not SCOPE's

The only derived view in the project (SCOPE §7). Every cell comes from a file:
  pairs and link records   links/pairing-map.md
  NM / FG source           corpus/<work>/<unit>.md front-matter (integrity_class, status)
  collated                 sources/comparisons/<work>/<unit>-witness-disagreements.yml
  EN                       translations/<unit>.md front-matter (status)
  ANN                      annotations/<unit>.md
  WEB                      site/pairs/<pair>.html
  version                  SCOPE.md "**Version.** Draft X"
  v1.0 checklist           the above, plus apparatus/decision-log.md (open items),
                           docs/sample-reads.md, apparatus/introduction.md,
                           site/downloads/, CITATION.cff (doi) — DEC-012
If a fact about a unit is not in that unit's file, it does not exist.
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FM_LINE = re.compile(r'^([A-Za-z_]+):\s*(.*)$')
MARK = {
    "pairs": ("<!-- state:pairs -->", "<!-- /state:pairs -->"),
    "stages": ("<!-- state:stages -->", "<!-- /state:stages -->"),
    "status": ("<!-- state:status -->", "<!-- /state:status -->"),
    "cite": ("<!-- state:cite -->", "<!-- /state:cite -->"),
    "v1": ("<!-- state:v1 -->", "<!-- /state:v1 -->"),
}
EN_LABEL = {"draft_cold_reviewed": "cold-reviewed", "draft": "draft"}


def front_matter(path):
    if not path.exists():
        return None
    t = path.read_text(encoding="utf-8")
    if not t.startswith("---"):
        return {}
    fm = t.split("---", 2)[1]
    meta = {}
    for line in fm.splitlines():
        m = FM_LINE.match(line)
        if m:
            meta[m.group(1)] = re.sub(r'\s+#.*$', '', m.group(2)).strip().strip('"')
    return meta


def pairing_map():
    text = (ROOT / "links/pairing-map.md").read_text(encoding="utf-8")
    return [
        {"n": int(m[1]), "nm": m[2], "fg": m[3], "link": m[4]}
        for m in re.finditer(
            r'^\|\s*(\d+)\s*\|\s*(NM-DISC\.\S+?)\s*\|\s*(FG-CONS\.\S+?)\s*\|\s*(\S+?)\s*\|',
            text, re.M)
    ]


def unit_state(unit):
    work = unit.split(".", 1)[0]
    c = front_matter(ROOT / f"corpus/{work}/{unit}.md")
    t = front_matter(ROOT / f"translations/{unit}.md")
    return {
        "source": f"{c.get('integrity_class', '?')} {c.get('status', '?')}" if c is not None else None,
        "established": bool(c) and c.get("status") == "established",
        "collated": (ROOT / f"sources/comparisons/{work}/{unit}-witness-disagreements.yml").exists(),
        "en": EN_LABEL.get(t.get("status", ""), t.get("status", "?")) if t is not None else None,
        "en_reviewed": bool(t) and t.get("status") == "draft_cold_reviewed",
        "ann": (ROOT / f"annotations/{unit}.md").exists(),
    }


def both(a, b, label):
    if a and b:
        return label
    if a or b:
        return "NM only" if a else "FG only"
    return "—"


def derive():
    rows, units = [], []
    for p in pairing_map():
        pair = p["nm"].split(".", 1)[1]
        nm, fg = unit_state(p["nm"]), unit_state(p["fg"])
        web = (ROOT / f"site/pairs/{pair}.html").exists()
        units += [nm, fg]
        en = nm["en"] if nm["en"] and nm["en"] == fg["en"] else both(nm["en"], fg["en"], "")
        rows.append(f"| {p['n']} | {p['nm']} | {p['fg']} | {p['link']} | "
                    f"{nm['source'] or '—'} | {fg['source'] or '—'} | {en or '—'} | "
                    f"{both(nm['ann'], fg['ann'], '✓')} | {'✓' if web else '—'} |")
        p["web"] = web
    pairs = ["| # | Machiavelli | Guicciardini | Link record | NM source | FG source | EN | ANN | WEB |",
             "|---|---|---|---|---|---|---|---|---|"] + rows

    pm = pairing_map()
    n_pairs, n_units = len(pm), 2 * len(pm)
    nm_units, fg_units = units[0::2], units[1::2]
    published = sum(2 for r in rows if r.rstrip().endswith("| ✓ |"))

    def line(stage, done, of, unit_word=""):
        return f"| {stage} | {done}{unit_word} | {of - done} | {of} |"

    stages = [
        "| Stage | Done | Remaining | Of |", "|---|---|---|---|",
        line("Link records", n_pairs, n_pairs),
        line("NM source established", sum(u["established"] for u in nm_units), n_pairs),
        line("FG source established", sum(u["established"] for u in fg_units), n_pairs),
        line("Collated against the comparison witness", sum(u["collated"] for u in units), n_units, " units"),
        line("Translated (draft, cold-reviewed)", sum(u["en_reviewed"] for u in units), n_units),
        line("Annotated", sum(u["ann"] for u in units), n_units),
        line("Published", published, n_units),
    ]
    v = version()
    status = (f"Version {v} · {published // 2} of {n_pairs} pairs published. The edition is versioned, not\n"
              "frozen; every page is dated. Per-pair progress is the table in `SCOPE.md` §2.")
    cite = ("> *A Conversation with Machiavelli: Guicciardini's Considerazioni on the\n"
            "> Discorsi*. Ed. David McDougall; AI-assisted English translation edited by\n"
            f"> David McDougall. Version {v}.\n"
            "> https://davidmcdougall.github.io/conversation-with-machiavelli/")
    return {"pairs": "\n".join(pairs), "stages": "\n".join(stages), "status": status, "cite": cite,
            "v1": v1_checklist(published // 2, n_pairs)}


def v1_checklist(pub_pairs, n_pairs):
    """DEC-012's release criteria, each from a file."""
    rows = []
    def row(label, done, state):
        rows.append(f"| {label} | {'✓' if done else '—'} | {state} |")

    row("All 39 pairs published", pub_pairs == n_pairs, f"{pub_pairs} of {n_pairs}")

    log = (ROOT / "apparatus/decision-log.md").read_text(encoding="utf-8")
    m = re.search(r'^## Open\b.*?$(.*?)(?=^## |\Z)', log, re.S | re.M)
    open_ids = re.findall(r'^\| (O\d+) \|', m.group(1), re.M) if m else []
    row("No open items", not open_ids,
        f"{len(open_ids)} open ({', '.join(open_ids)})" if open_ids else "none open")

    sr = ROOT / "docs/sample-reads.md"
    reads = []
    if sr.exists():
        part = sr.read_text(encoding="utf-8").split("## Log", 1)[-1]
        for cells in re.findall(r'^\|([^\n]+)\|$', part, re.M):
            c = [x.strip() for x in cells.split("|")]
            if len(c) >= 3 and c[0] not in ("Pair", "") and not set(c[0]) <= set("-"):
                reads.append(c)
    done = [c for c in reads if c[2]]
    failed = [c for c in done if c[2].lower().startswith("fixed")]
    row("Sample read of the English", reads and len(done) == len(reads),
        f"{len(done)} of {len(reads)} read" + (f", {len(failed)} with errors fixed" if failed else ""))

    intro = ROOT / "apparatus/introduction.md"
    words = len(intro.read_text(encoding="utf-8").split()) if intro.exists() else 0
    row("Introduction (1,500–2,500 words)", 1500 <= words <= 2500,
        f"{words:,} words" if intro.exists() else "not written")

    dl = ROOT / "site/downloads"
    have = [f for f in ("PDF", "EPUB") if any(dl.glob(f"*.{f.lower()}"))] if dl.exists() else []
    row("PDF and EPUB", len(have) == 2, ", ".join(have) + " built" if have else "not built")

    doi = re.search(r'^doi:\s*"?(\S+?)"?$', (ROOT / "CITATION.cff").read_text(encoding="utf-8"), re.M)
    row("Zenodo DOI", bool(doi), doi.group(1) if doi else "none")

    return "\n".join(["| Criterion | Done | State |", "|---|---|---|"] + rows)


def version():
    m = re.search(r'\*\*Version\.\*\*\s*Draft\s*(\S+)', (ROOT / "SCOPE.md").read_text(encoding="utf-8"))
    if not m:
        sys.exit('SCOPE.md has no "**Version.** Draft X" line')
    return m.group(1)


def citation_problem():
    """CITATION.cff's version must be SCOPE's (0.3 → 0.3 or 0.3.N)."""
    v = version()
    m = re.search(r'^version:\s*"?([^"\s]+)', (ROOT / "CITATION.cff").read_text(encoding="utf-8"), re.M)
    cv = m.group(1) if m else None
    if cv != v and not (cv or "").startswith(v + "."):
        return f"CITATION.cff version {cv} does not match SCOPE.md version {v}"
    return None


def splice(text, key, body, name="SCOPE.md"):
    start, end = MARK[key]
    pat = re.compile(re.escape(start) + r".*?" + re.escape(end), re.S)
    if not pat.search(text):
        sys.exit(f"{name} has no {start} … {end} markers")
    return pat.sub(lambda _: f"{start}\n{body}\n{end}", text)


def main():
    out = derive()
    targets = {"SCOPE.md": ("pairs", "stages", "v1"), "README.md": ("status", "cite")}
    stale = []
    for name, keys in targets.items():
        path = ROOT / name
        text = path.read_text(encoding="utf-8")
        new = text
        for k in keys:
            new = splice(new, k, out[k], name)
        if new != text:
            stale.append(name)
            if "--write" in sys.argv:
                path.write_text(new, encoding="utf-8")
    if "--write" in sys.argv:
        print(", ".join(stale) + ": rewritten" if stale else "SCOPE.md, README.md: already current")
        if citation_problem():
            print("warning:", citation_problem(), "(update CITATION.cff by hand at release)")
    elif "--check" in sys.argv:
        bad = [f"{n} is stale; run scripts/state --write" for n in stale]
        if citation_problem():
            bad.append(citation_problem())
        if bad:
            print("\n".join(bad))
            sys.exit(1)
    else:
        print(out["pairs"] + "\n\n" + out["stages"] + "\n\n" + out["v1"])


if __name__ == "__main__":
    main()
